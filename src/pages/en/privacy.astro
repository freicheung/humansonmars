---
import Base from '../../layouts/Base.astro';
---

<Base title="Privacy" description="What Humans on Mars collects and what it does not.">
  <section class="prose-wrap">
    <article class="prose">
      <p class="eyebrow">Privacy</p>
      <h1 class="display-sm">Privacy</h1>
      <p>
        The tools run entirely in your browser. The mass, dates and messages you enter are not sent to us or stored.
      </p>
      <p>
        We have no accounts, no sign-up and no database. Before we add analytics or advertising, this page will be updated to
        explain what is collected, by whom, and how to give or withdraw consent.
      </p>
    </article>
  </section>
</Base>
